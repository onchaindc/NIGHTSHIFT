# Copy this file to .env.local (Freebuff loads .env/.env.local automatically).
# ── Telegraph (paid intelligence) ────────────────────────────────────────────
# Official testnet node from docs.telegraphprotocol.com. Free discovery works
# with no key at all; PAID inference is x402 (no API key exists).
TELEGRAPH_NODE_URL=https://devnode.telegraphprotocol.com

# Wallet private key used to SIGN x402 payments (USDC, Base Sepolia, chain 84532).
# Never shipped to the browser; only read inside server code.
# Get test funds: https://faucet.circle.com (20 test USDC / 2h) + test ETH for gas.
TELEGRAPH_EVM_PRIVATE_KEY=

# ── Telegram bot (server-side only) ─────────────────────────────────────────
# Create a bot via @BotFather, then setWebhook to https://<host>/api/telegram/webhook
TELEGRAM_BOT_TOKEN=
# Recommended: random string; Telegram echoes it in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=

# ── Task engine ─────────────────────────────────────────────────────────────
# Default per-task spend ceiling in USD cents (100 = $1.00).
NIGHTSHIFT_DEFAULT_SPEND_LIMIT_CENTS=100
# Where tasks.json is persisted (defaults to ./.data, gitignored).
# NIGHTSHIFT_DATA_DIR=

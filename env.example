# Copy this file to .env.local (Freebuff loads .env/.env.local automatically).
# ── Telegraph (paid intelligence) ────────────────────────────────────────────
# Official testnet node from docs.telegraphprotocol.com. Free discovery works
# with no key at all; PAID inference is x402 (no API key exists).
TELEGRAPH_NODE_URL=https://devnode.telegraphprotocol.com

# Server-side payer for the legacy Console/Watch paid research and for the
# test-USDC faucet. The interactive Terminal never uses it: Terminal asks are
# signed by the user's connected wallet (Privy). Removing this key disables
# those server-side features and the faucet, not the Terminal.
# Never shipped to the browser; only read inside server code.
TELEGRAPH_EVM_PRIVATE_KEY=

# ── Telegram bot (server-side only) ─────────────────────────────────────
# Create a bot via @BotFather, then setWebhook to https://<host>/api/telegram/webhook
TELEGRAM_BOT_TOKEN=
# Recommended: random string; Telegram echoes it in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=

# ── Task engine ──────────────────────────────────────────────────────
# Default per-task spend ceiling in USD cents (100 = $1.00).
NIGHTSHIFT_DEFAULT_SPEND_LIMIT_CENTS=100
# Where tasks.json is persisted (defaults to ./.data, gitignored).
# NIGHTSHIFT_DATA_DIR=

# ── Production / serverless ─────────────────────────────────────────
# Set to 1 on Vercel (or any platform without a long-lived process) so status
# reports the external-cron worker mode instead of an in-process scheduler.
# NIGHTSHIFT_EXTERNAL_CRON=1

# Watch auto-check interval in ms (min 30_000). Default 600_000 (10 min).
# Only used by the in-process scheduler; serverless relies on the cron tick.
# NIGHTSHIFT_WATCH_INTERVAL_MS=600000

# Set to 0 to disable automatic watch checks entirely.
# NIGHTSHIFT_WATCH_AUTOCHECK=1

# Privy (in-app / connected wallets for Funds)
PRIVY_APP_ID=
